# Copy this file to .env and fill it in, or just run:  python setup_wizard.py
# NEVER commit .env. It holds secrets, and git is set to ignore it.

# Which broker supplies prices: mock | fyers | angelone
BROKER=mock

# --- Fyers (v3 API) ---
# From your app at https://myapi.fyers.in/dashboard -> Create App.
FYERS_CLIENT_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=
# Written for you each trading morning by:  python fyers_login.py
FYERS_ACCESS_TOKEN=

# --- Angel One (SmartAPI) ---
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# --- Screening ---
# Smallest total bid and ask depth, in shares, that a stock needs to be screened in.
SCREENER_MIN_DEPTH_QTY=2000

# --- Optional trading settings (leave blank to use the defaults) ---
# These change what the experiment measures: results before and after a change
# are not comparable.
SCREENER_CAPITAL_PER_TRADE=
SCREENER_STOP_LOSS_PERCENT=
SCREENER_TARGET_PERCENT=
SCREENER_MAX_HOLD_MINUTES=
SCREENER_MAX_POSITIONS=
# Comma-separated, for example NSE:SBIN-EQ,NSE:PNB-EQ (blank = the built-in list)
SCREENER_WATCHLIST=